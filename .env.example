# Copy this file to .env and fill in values. Nothing here is required to run
# the app locally with the mock AI provider and SQLite.

# --- Database -----------------------------------------------------------
# SQLite for local dev (zero setup). Point at a real Postgres instance in
# production by changing `provider = "postgresql"` in prisma/schema.prisma
# and setting DATABASE_URL to a postgres:// connection string.
DATABASE_URL="file:./dev.db"

# --- Auth -----------------------------------------------------------------
# Random secret used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-random-32-byte-base64-string"

# Set to "true" only when deployed behind HTTPS. Leave unset/false for local
# http://localhost development — a Secure cookie is never sent over plain HTTP.
COOKIE_SECURE=false

# --- AI provider ------------------------------------------------------------
# "mock" (default, no key needed) | "anthropic" | "openai" | "google"
# If unset, the app auto-detects the first provider with a configured key,
# falling back to "mock". The app always works with zero keys configured.
AI_PROVIDER=mock

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-flash
